DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sistema_igrejas?schema=public"
ASAAS_ENVIRONMENT="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
# Fixed public HTTPS for Asaas sandbox webhook. Path must be /webhooks/asaas.
# Named Cloudflare tunnel (cfargotunnel.com) is allowed. trycloudflare and Railway are rejected.
ASAAS_WEBHOOK_PUBLIC_URL=""
RESEND_API_KEY=""
# Bare verified address only. Assisted recovery rejects "Name <email>".
EVENTS_EMAIL_FROM=""
# Public HTTPS participant app origin, no userinfo/query/hash.
EVENTS_APP_BASE_URL=""
# Public or loopback API origin used by the Next apps. No userinfo/query/hash.
NEXT_PUBLIC_API_BASE_URL=""
# AES-256-GCM key for Eventos integrations (Mailchimp, WhatsApp). 64 hex chars (32 bytes).
# Leave empty until connecting those providers. Missing or invalid key returns 503 on secret providers.
EVENTS_INTEGRATIONS_ENCRYPTION_KEY=""

# Checkout security operational prep (inactive; not read by app.ts/server.ts).
# Shared Redis runtime user must be checkout_runtime, pathname /0, no query/hash.
# Loopback may use redis://. Non-loopback requires rediss://. No production defaults.
REDIS_URL=""
CHECKOUT_REDIS_ADMIN_URL=""
CHECKOUT_REDIS_PASSWORD=""
CHECKOUT_REDIS_RUNTIME_PASSWORD=""
CHECKOUT_SECURITY_ORIGINS=""
CHECKOUT_SECURITY_BUCKET_SECRET=""
CHECKOUT_SECURITY_WINDOW_MS=""
CHECKOUT_SECURITY_IP_LIMIT=""
CHECKOUT_SECURITY_CREDENTIAL_LIMIT=""
CHECKOUT_SECURITY_BODY_LIMIT=""
CHECKOUT_SECURITY_STORE_TIMEOUT_MS=""
CHECKOUT_SECURITY_REQUEST_TIMEOUT_MS=""
CHECKOUT_SECURITY_ALLOW_LOCAL_HTTP=""
CHECKOUT_SECURITY_HTTPS_ONLY=""
